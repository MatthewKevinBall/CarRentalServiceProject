<Project>

  <!--
    MSBuild stops at the FIRST Directory.Build.props it finds walking up the tree,
    so this file would hide the root one. Import the root explicitly to inherit it.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <!-- Settings shared by every test project. -->
  <PropertyGroup>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2"/>
  </ItemGroup>

</Project>
